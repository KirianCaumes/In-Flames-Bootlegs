# Copy this file to .env.local and fill in the values

# Service account JSON (on a single line) used to read the Google Sheet.
# The Sheet must be shared with the service account's client_email: Viewer for the site, Editor for the dead links checker (npm run check-links).
# The new bootlegs finder (npm run find-bootlegs) also reads the sheet comments: enable the Drive API on the service account's project.
GOOGLE_API_JSON={"type":"service_account", ...}
# Google API key used for YouTube playlist thumbnails
GOOGLE_API_KEY=your_youtube_api_key
# ID of the Google Sheet (the <id> in https://docs.google.com/spreadsheets/d/<id>/edit)
GOOGLE_SHEET_ID=your_google_sheet_id
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# SMTP settings used by the dead links checker (npm run check-links) to email its report.
# Port 465 uses implicit TLS, other ports (587, 25) upgrade through STARTTLS.
MAIL_FROM=In Flames Bootlegs <bootlegs@example.com>
# One or more recipients, comma separated
MAIL_TO=you@example.com
MAIL_HOST=smtp.example.com
MAIL_PORT=587
# Leave MAIL_USER empty for an unauthenticated relay
MAIL_USER=bootlegs@example.com
MAIL_PASS=your_smtp_password
# Optional - locale used to format the date and numbers of the email (default: en-US)
LOCALE=en-US
